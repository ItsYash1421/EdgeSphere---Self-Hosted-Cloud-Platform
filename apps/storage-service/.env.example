# Storage Service Environment Variables
NODE_ENV=development
PORT=3002

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=edgesphere
DB_PASSWORD=edgesphere_secret
DB_NAME=edgesphere

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secret_123
MINIO_USE_SSL=false

# Redis (for cache invalidation pub/sub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# JWT (for verifying tokens — shared secret with auth-service)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# Storage limits
MAX_FILE_SIZE_BYTES=5368709120
MAX_BUCKET_COUNT=100
QUOTA_PER_USER_GB=10

LOG_LEVEL=info
